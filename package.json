{
    "name": "ns-js-snippets-reload",
    "displayName": "Netsuite - JS Snippets Reload",
    "publisher": "alexandrejcorrea",
    "description": "NetSuite SuiteScript 2.x snippets, N/* autocomplete, hover docs, diagnostics, and API pattern templates for JavaScript in VS Code.",
    "version": "0.1.1",
    "engines": {
        "vscode": "^1.62.0"
    },
    "repository": {
        "url": "https://github.com/AlexandreD3v/ns-js-snippets_reload",
        "type": "git"
    },
    "icon": "icon.png",
    "main": "./extension.js",
    "activationEvents": [
        "onLanguage:javascript"
    ],
    "categories": [
        "Snippets",
        "Programming Languages"
    ],
    "scripts": {
        "test": "node test/ratingPrompt.test.js"
    },
    "contributes": {
        "snippets": [
            {
                "language": "javascript",
                "path": "./snippets/snippets.code-snippets"
            }
        ],
        "configuration": {
            "title": "NetSuite SuiteScript",
            "properties": {
                "netsuite.defaultApiVersion": {
                    "type": "string",
                    "default": "2.1",
                    "description": "Default @NApiVersion value used in future snippet templates."
                },
                "netsuite.defaultModuleScope": {
                    "type": "string",
                    "default": "SameAccount",
                    "enum": [
                        "SameAccount",
                        "Public"
                    ],
                    "description": "Default @NModuleScope value used in future snippet templates."
                },
                "netsuite.enableDiagnostics": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show SuiteScript validation warnings in JavaScript files."
                }
            }
        }
    },
    "devDependencies": {
        "vsce": "^2.2.0"
    }
}
