{
    "name": "ns-js-snippets-reload",
    "displayName": "%displayName%",
    "publisher": "alexandrejcorrea",
    "description": "%description%",
    "version": "0.7.1",
    "license": "GPL-3.0-only",
    "keywords": [
        "netsuite",
        "suitescript",
        "suiteql",
        "sdf",
        "suitecloud",
        "oracle",
        "erp",
        "governance",
        "javascript",
        "snippets"
    ],
    "homepage": "https://github.com/AlexandreD3v/ns-js-snippets_reload#readme",
    "bugs": {
        "url": "https://github.com/AlexandreD3v/ns-js-snippets_reload/issues"
    },
    "engines": {
        "vscode": "^1.85.0"
    },
    "repository": {
        "url": "https://github.com/AlexandreD3v/ns-js-snippets_reload",
        "type": "git"
    },
    "icon": "icon.png",
    "main": "./extension.js",
    "activationEvents": [
        "onLanguage:javascript",
        "onLanguage:suiteql"
    ],
    "categories": [
        "Snippets",
        "Programming Languages",
        "Linters"
    ],
    "scripts": {
        "test": "node test/ratingPrompt.test.js && node test/tier2.test.js && node test/foundation.test.js && node test/migration.test.js && node test/suiteql.test.js && node test/toolkit.test.js",
        "test:integration": "node scripts/run-integration.js",
        "test:all": "npm test && npm run test:integration"
    },
    "contributes": {
        "languages": [
            {
                "id": "suiteql",
                "aliases": [
                    "SuiteQL",
                    "suiteql"
                ],
                "extensions": [
                    ".suiteql",
                    ".sql"
                ],
                "configuration": "./syntaxes/suiteql.language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "suiteql",
                "scopeName": "source.suiteql",
                "path": "./syntaxes/suiteql.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "javascript",
                "path": "./snippets/snippets.code-snippets"
            },
            {
                "language": "typescript",
                "path": "./snippets/snippets.code-snippets"
            },
            {
                "language": "javascriptreact",
                "path": "./snippets/snippets.code-snippets"
            },
            {
                "language": "typescriptreact",
                "path": "./snippets/snippets.code-snippets"
            }
        ],
        "commands": [
            {
                "command": "netsuite.newScript",
                "title": "%command.newScript.title%",
                "category": "NetSuite"
            },
            {
                "command": "netsuite.insertScriptParameters",
                "title": "%command.insertScriptParameters.title%",
                "category": "NetSuite"
            },
            {
                "command": "netsuite.wrapSelectionInDefine",
                "title": "%command.wrapSelectionInDefine.title%",
                "category": "NetSuite"
            },
            {
                "command": "netsuite.validateFile",
                "title": "%command.validateFile.title%",
                "category": "NetSuite"
            },
            {
                "command": "netsuite.reloadCustomFields",
                "title": "%command.reloadCustomFields.title%",
                "category": "NetSuite"
            },
            {
                "command": "netsuite.createCustomFieldsConfig",
                "title": "%command.createCustomFieldsConfig.title%",
                "category": "NetSuite"
            },
            {
                "command": "netsuite.auditWorkspace21",
                "title": "%command.auditWorkspace21.title%",
                "category": "NetSuite"
            },
            {
                "command": "netsuite.convertCurrentScript21",
                "title": "%command.convertCurrentScript21.title%",
                "category": "NetSuite"
            },
            {
                "command": "netsuite.convertWorkspace21",
                "title": "%command.convertWorkspace21.title%",
                "category": "NetSuite"
            },
            {
                "command": "netsuite.createSuiteQLQuery",
                "title": "%command.createSuiteQLQuery.title%",
                "category": "NetSuite"
            },
            {
                "command": "netsuite.extractSuiteQLToFile",
                "title": "%command.extractSuiteQLToFile.title%",
                "category": "NetSuite"
            },
            {
                "command": "netsuite.insertSuiteQLAsNQuery",
                "title": "%command.insertSuiteQLAsNQuery.title%",
                "category": "NetSuite"
            },
            {
                "command": "netsuite.createSuiteQLSchema",
                "title": "%command.createSuiteQLSchema.title%",
                "category": "NetSuite"
            },
            {
                "command": "netsuite.suitecloudValidate",
                "title": "%command.suitecloudValidate.title%",
                "category": "NetSuite"
            },
            {
                "command": "netsuite.suitecloudDeploy",
                "title": "%command.suitecloudDeploy.title%",
                "category": "NetSuite"
            },
            {
                "command": "netsuite.suitecloudUpload",
                "title": "%command.suitecloudUpload.title%",
                "category": "NetSuite"
            },
            {
                "command": "netsuite.suitecloudCreateProject",
                "title": "%command.suitecloudCreateProject.title%",
                "category": "NetSuite"
            },
            {
                "command": "netsuite.suitecloudAccountSetup",
                "title": "%command.suitecloudAccountSetup.title%",
                "category": "NetSuite"
            },
            {
                "command": "netsuite.suitecloudImportObject",
                "title": "%command.suitecloudImportObject.title%",
                "category": "NetSuite"
            },
            {
                "command": "netsuite.suitecloudImportFile",
                "title": "%command.suitecloudImportFile.title%",
                "category": "NetSuite"
            },
            {
                "command": "netsuite.suitecloudOpenRelatedObject",
                "title": "%command.suitecloudOpenRelatedObject.title%",
                "category": "NetSuite"
            },
            {
                "command": "netsuite.copyScriptForUpload",
                "title": "%command.copyScriptForUpload.title%",
                "category": "NetSuite"
            },
            {
                "command": "netsuite.openScriptRecordUrl",
                "title": "%command.openScriptRecordUrl.title%",
                "category": "NetSuite"
            },
            {
                "command": "netsuite.copyAiContext",
                "title": "%command.copyAiContext.title%",
                "category": "NetSuite"
            },
            {
                "command": "netsuite.configureDeveloperAssistant",
                "title": "%command.configureDeveloperAssistant.title%",
                "category": "NetSuite"
            },
            {
                "command": "netsuite.addModuleImport",
                "title": "%command.addModuleImport.title%",
                "category": "NetSuite"
            },
            {
                "command": "netsuite.goToFieldDefinition",
                "title": "%command.goToFieldDefinition.title%",
                "category": "NetSuite"
            },
            {
                "command": "netsuite.scaffoldJestTest",
                "title": "%command.scaffoldJestTest.title%",
                "category": "NetSuite"
            },
            {
                "command": "netsuite.debugShowRatingPrompt",
                "title": "%command.debugShowRatingPrompt.title%",
                "category": "NetSuite"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "netsuite.newScript"
                },
                {
                    "command": "netsuite.insertScriptParameters"
                },
                {
                    "command": "netsuite.wrapSelectionInDefine"
                },
                {
                    "command": "netsuite.validateFile"
                },
                {
                    "command": "netsuite.reloadCustomFields"
                },
                {
                    "command": "netsuite.createCustomFieldsConfig"
                },
                {
                    "command": "netsuite.auditWorkspace21"
                },
                {
                    "command": "netsuite.convertCurrentScript21"
                },
                {
                    "command": "netsuite.convertWorkspace21"
                },
                {
                    "command": "netsuite.createSuiteQLQuery"
                },
                {
                    "command": "netsuite.extractSuiteQLToFile"
                },
                {
                    "command": "netsuite.insertSuiteQLAsNQuery"
                },
                {
                    "command": "netsuite.createSuiteQLSchema"
                },
                {
                    "command": "netsuite.suitecloudDeploy"
                },
                {
                    "command": "netsuite.suitecloudValidate"
                },
                {
                    "command": "netsuite.suitecloudUpload"
                },
                {
                    "command": "netsuite.suitecloudCreateProject"
                },
                {
                    "command": "netsuite.suitecloudAccountSetup"
                },
                {
                    "command": "netsuite.suitecloudImportObject"
                },
                {
                    "command": "netsuite.suitecloudImportFile"
                },
                {
                    "command": "netsuite.suitecloudOpenRelatedObject"
                },
                {
                    "command": "netsuite.copyScriptForUpload"
                },
                {
                    "command": "netsuite.openScriptRecordUrl"
                },
                {
                    "command": "netsuite.copyAiContext"
                },
                {
                    "command": "netsuite.configureDeveloperAssistant"
                },
                {
                    "command": "netsuite.addModuleImport"
                },
                {
                    "command": "netsuite.goToFieldDefinition"
                },
                {
                    "command": "netsuite.scaffoldJestTest"
                },
                {
                    "command": "netsuite.debugShowRatingPrompt",
                    "when": "config.netsuite.debugRatingPrompt"
                }
            ],
            "editor/context": [
                {
                    "command": "netsuite.wrapSelectionInDefine",
                    "when": "editorLangId == javascript",
                    "group": "netsuite@1"
                },
                {
                    "command": "netsuite.validateFile",
                    "when": "editorLangId == javascript",
                    "group": "netsuite@2"
                },
                {
                    "command": "netsuite.insertScriptParameters",
                    "when": "editorLangId == javascript",
                    "group": "netsuite@3"
                },
                {
                    "command": "netsuite.convertCurrentScript21",
                    "when": "editorLangId == javascript",
                    "group": "netsuite@4"
                },
                {
                    "command": "netsuite.extractSuiteQLToFile",
                    "when": "editorLangId == javascript",
                    "group": "netsuite@5"
                },
                {
                    "command": "netsuite.insertSuiteQLAsNQuery",
                    "when": "editorLangId == suiteql",
                    "group": "netsuite@1"
                }
            ]
        },
        "configuration": {
            "title": "%config.title%",
            "properties": {
                "netsuite.defaultApiVersion": {
                    "type": "string",
                    "default": "2.1",
                    "description": "%config.defaultApiVersion.description%"
                },
                "netsuite.defaultModuleScope": {
                    "type": "string",
                    "default": "SameAccount",
                    "enum": [
                        "SameAccount",
                        "Public"
                    ],
                    "description": "%config.defaultModuleScope.description%"
                },
                "netsuite.enableDiagnostics": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.enableDiagnostics.description%"
                },
                "netsuite.enableGovernanceDiagnostics": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.enableGovernanceDiagnostics.description%"
                },
                "netsuite.customFieldsPath": {
                    "type": "string",
                    "default": ".vscode/netsuite-fields.json",
                    "description": "%config.customFieldsPath.description%"
                },
                "netsuite.sdfFieldDiscovery": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.sdfFieldDiscovery.description%"
                },
                "netsuite.suiteqlSchemaPath": {
                    "type": "string",
                    "default": ".vscode/netsuite-suiteql-schema.json",
                    "description": "%config.suiteqlSchemaPath.description%"
                },
                "netsuite.suitecloudPath": {
                    "type": "string",
                    "default": "suitecloud",
                    "description": "%config.suitecloudPath.description%"
                },
                "netsuite.suitecloudValidateBeforeDeploy": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.suitecloudValidateBeforeDeploy.description%"
                },
                "netsuite.scriptRecordUrlTemplate": {
                    "type": "string",
                    "default": "",
                    "description": "%config.scriptRecordUrlTemplate.description%"
                },
                "netsuite.debugRatingPrompt": {
                    "type": "boolean",
                    "default": false,
                    "description": "%config.debugRatingPrompt.description%"
                }
            }
        },
        "languageModelTools": [
            {
                "name": "netsuite_get_script_context",
                "displayName": "%lm.getScriptContext.displayName%",
                "toolReferenceName": "netsuiteScriptContext",
                "modelDescription": "Read sanitized context for the active SuiteScript or SuiteQL editor: annotations, imported N/* modules, diagnostics, migration notes, and SDF metadata. Does not return secrets or credentials.",
                "userDescription": "%lm.getScriptContext.userDescription%",
                "icon": "$(file-code)",
                "tags": ["netsuite"],
                "canBeReferencedInPrompt": true,
                "inputSchema": {
                    "type": "object",
                    "properties": {},
                    "additionalProperties": false
                }
            },
            {
                "name": "netsuite_analyze_suitescript",
                "displayName": "%lm.analyzeSuiteScript.displayName%",
                "toolReferenceName": "netsuiteAnalyzeSuiteScript",
                "modelDescription": "Return SuiteScript diagnostics and 2.1 migration notes for the active editor. Does not modify the file.",
                "userDescription": "%lm.analyzeSuiteScript.userDescription%",
                "icon": "$(warning)",
                "tags": ["netsuite"],
                "canBeReferencedInPrompt": true,
                "inputSchema": {
                    "type": "object",
                    "properties": {},
                    "additionalProperties": false
                }
            },
            {
                "name": "netsuite_get_suiteql_schema",
                "displayName": "%lm.getSuiteQLSchema.displayName%",
                "toolReferenceName": "netsuiteSuiteQLSchema",
                "modelDescription": "Return the local SuiteQL table and column hints available to the extension for the active workspace. This is bundled metadata plus optional workspace overrides, not a live NetSuite account schema.",
                "userDescription": "%lm.getSuiteQLSchema.userDescription%",
                "icon": "$(database)",
                "tags": ["netsuite"],
                "canBeReferencedInPrompt": true,
                "inputSchema": {
                    "type": "object",
                    "properties": {},
                    "additionalProperties": false
                }
            },
            {
                "name": "netsuite_get_sdf_context",
                "displayName": "%lm.getSdfContext.displayName%",
                "toolReferenceName": "netsuiteSdfContext",
                "modelDescription": "Return SuiteCloud project paths and SDF object metadata discovered locally for the active file. Does not call NetSuite or the SuiteCloud CLI.",
                "userDescription": "%lm.getSdfContext.userDescription%",
                "icon": "$(files)",
                "tags": ["netsuite"],
                "canBeReferencedInPrompt": true,
                "inputSchema": {
                    "type": "object",
                    "properties": {},
                    "additionalProperties": false
                }
            }
        ]
    },
    "devDependencies": {
        "@vscode/test-cli": "^0.0.15",
        "@vscode/test-electron": "^3.1.0",
        "@vscode/vsce": "^4.1.0"
    },
    "dependencies": {
        "@babel/parser": "^7.29.9",
        "@babel/traverse": "^7.29.8"
    }
}
