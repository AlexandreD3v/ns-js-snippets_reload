{
  "scopeName": "source.suiteql",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#strings" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-dash.suiteql",
          "match": "--.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.other.suiteql",
          "match": "(?i)\\b(select|from|where|join|inner|left|right|on|and|or|group|by|order|having|limit|offset|union|distinct|as|in|not|null|like|between|exists|case|when|then|else|end)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.single.suiteql",
          "begin": "'",
          "end": "'"
        }
      ]
    }
  }
}
